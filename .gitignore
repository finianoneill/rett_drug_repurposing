# ===== Data: never commit raw or derived bulk data =====
# Fetchers live in scripts/, schemas in src/, but the actual data files
# stay out of git — most sources require attribution and bulk redistribution
# is rarely license-clean. data/.gitkeep preserves the directory.
data/
!data/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet
*.h5
*.h5ad
*.gctx
*.gct
*.mtx
*.loom

# ===== Secrets =====
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ===== Python =====
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual envs
.venv/
venv/
env/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
coverage.xml

# ===== Jupyter =====
# Keep notebooks/journal/*.ipynb committed — that's the learning log.
# But never commit checkpoint dirs or stripped outputs.
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ===== LangGraph / local agentic state =====
*.sqlite
*.sqlite3
*.db
checkpoints/
.langgraph_cache/

# ===== Langfuse (if self-hosted for dev) =====
langfuse-data/

# ===== Next.js / Node =====
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
frontend/.vercel/
frontend/.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===== Editor / IDE =====
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.netrwhist
Session.vim
*.un~

# ===== OS =====
.DS_Store
._*
.Spotlight-V100
Thumbs.db

# ===== Scratch =====
scratch/
sandbox/
tmp/
*.tmp
*.bak
notes-private/